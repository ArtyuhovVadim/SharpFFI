<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net48;net6.0;net8.0;net10.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Optimize>true</Optimize>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="IndexRange" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpFFI.Primitives\SharpFFI.Primitives.csproj"
                          Condition="'$(TargetFramework)' == 'net48'"
                          SetTargetFramework="TargetFramework=netstandard2.0" />

        <ProjectReference Include="..\SharpFFI.Primitives\SharpFFI.Primitives.csproj"
                          Condition="'$(TargetFramework)' != 'net48'"
                          SetTargetFramework="TargetFramework=net6.0" />
    </ItemGroup>

</Project>
