<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharpFFI.Primitives\SharpFFI.Primitives.csproj"
                          Condition="'$(TargetFramework)' == 'net48'"
                          SetTargetFramework="TargetFramework=netstandard2.0" />

        <ProjectReference Include="..\SharpFFI.Primitives\SharpFFI.Primitives.csproj"
                          Condition="'$(TargetFramework)' == 'net8.0'"
                          SetTargetFramework="TargetFramework=netstandard2.1" />

        <ProjectReference Include="..\SharpFFI.Primitives\SharpFFI.Primitives.csproj"
                          Condition="'$(TargetFramework)' == 'net10.0'"
                          SetTargetFramework="TargetFramework=net6.0" />
        <ProjectReference Include="..\SharpFFI.Generators.Core\SharpFFI.Generators.Core.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\SharpFFI.Generators.C\SharpFFI.Generators.C.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\SharpFFI.Generators.Cpp\SharpFFI.Generators.Cpp.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
